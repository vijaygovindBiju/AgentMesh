# AgentMesh — Worker Agent Configuration (Machine B)
#
# This file contains the environment variables needed to run agent-agy
# on a remote worker machine. The worker only needs NATS connectivity
# and agy CLI access — no PostgreSQL or coordinator required.
#
# Copy this file to .env.worker and fill in your values.
# Source it before running agent-agy:
#   source .env.worker && agent-agy
#
# NEVER commit .env.worker to version control.

# ─── NATS Connection ──────────────────────────────────────────────────────────
# URL of the NATS server running on Machine A (coordinator host).
# Replace <COORDINATOR_IP> with the actual LAN/VPN IP of Machine A.
NATS_URL=nats://<COORDINATOR_IP>:4222

# NATS authentication token. Must match the token configured on Machine A.
# Get this from the coordinator operator — NEVER commit the real value.
NATS_AUTH_TOKEN=

# ─── Agent Identity ───────────────────────────────────────────────────────────
# Human-readable owner name for this agent.
AGY_AGENT_OWNER=

# API key for authentication with the coordinator.
# On first registration, any non-empty value works (Trust On First Use).
# For re-registration, must match the original key.
AGY_AGENT_API_KEY=

# ─── Agent Configuration (Optional) ──────────────────────────────────────────
# Fixed agent UUID. Omit to auto-generate on each run.
# AGY_AGENT_ID=

# Path to the agy CLI binary. Default: ~/.local/bin/agy
# AGY_BIN_PATH=/usr/local/bin/agy

# AI model for agy to use. Default: gemini-3.8-flash-low
# AGY_MODEL=gemini-3.8-flash-low

# Effort level for agy. Default: inherited from agy config.
# AGY_EFFORT=low

# Working directory for task execution. Default: uses repo_path from TaskSpec.
# AGY_WORKSPACE_DIR=/path/to/local/repo/clone

# Task execution timeout in seconds. Default: 300 (5 minutes).
# AGY_TIMEOUT_SECS=300

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level. Options: trace | debug | info | warn | error
RUST_LOG=agent_agy=info,info
