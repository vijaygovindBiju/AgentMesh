# AgentMesh — Required Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER paste API keys into chat or source code.
#
# cp .env.example .env

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string for the coordinator's database.
# Default matches docker-compose.yml dev configuration.
DATABASE_URL=postgres://agentmesh:agentmesh_dev@localhost:5432/agentmesh

# Password used by docker-compose postgres service.
# Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=agentmesh_dev

# ─── NATS ──────────────────────────────────────────────────────────────────────
# NATS server URL. Default: local docker-compose instance.
NATS_URL=nats://localhost:4222

# NATS auth token. Must match the token passed to the nats container.
# In production, replace with NKey credentials (see docs/decisions/002-*.md).
NATS_AUTH_TOKEN=agentmesh_dev_token

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Which LLM provider the coordinator uses for task decomposition.
# Options: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Which model to use within the selected provider.
# Examples:
#   anthropic : claude-3-5-sonnet-20241022
#   openai    : gpt-4o
#   gemini    : gemini-1.5-pro
AI_MODEL=claude-3-5-sonnet-20241022

# Provider API keys — set only the one you need.
# Raw keys are NEVER stored in source files or the database.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Coordinator ───────────────────────────────────────────────────────────────
# Log level for the coordinator binary.
# Options: trace | debug | info | warn | error
RUST_LOG=agentmesh=debug,coordinator=debug,info

# ─── Mock Agent ────────────────────────────────────────────────────────────────
# Simulated work delay per task (milliseconds).
# Increase for more realistic simulation, decrease for fast testing.
MOCK_TASK_DELAY_MS=3000

# NATS agent identity for the mock agent.
# Each running mock agent instance must have a unique ID.
MOCK_AGENT_ID=mock-agent-a
MOCK_AGENT_OWNER=Alice

# API key assigned to this agent by the coordinator at registration.
# Generated by the coordinator on first registration; set here for reconnection.
MOCK_AGENT_API_KEY=
