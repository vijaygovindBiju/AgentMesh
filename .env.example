# AgentMesh — Environment Variables
#
# Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# The coordinator loads .env automatically (dotenvy).
# The agent binaries (agent-mock, agent-agy) do NOT read .env — they only read
# the process environment. Export the variables or prefix them on the command line.
#
# NEVER commit .env to version control.

# ─── PostgreSQL (coordinator + tests) ──────────────────────────────────────────
# Must match the docker-compose.yml postgres service (user agentmesh, db agentmesh).
DATABASE_URL=postgres://agentmesh:agentmesh_dev@localhost:5432/agentmesh

# Password used by the docker-compose postgres service. Must match DATABASE_URL.
# Changing it after the first `docker compose up` requires `docker compose down -v`.
POSTGRES_PASSWORD=agentmesh_dev

# ─── NATS (coordinator + agents) ───────────────────────────────────────────────
# Agents on other machines replace localhost with the coordinator host's IP.
NATS_URL=nats://localhost:4222

# Token passed to the NATS container (-auth). Every client must present it.
# Change it before exposing port 4222 beyond your machine, then `docker compose up -d`.
# TLS / user-password auth exist in the library only (see README "Security").
NATS_AUTH_TOKEN=agentmesh_dev_token

# ─── AI Provider (coordinator) ─────────────────────────────────────────────────
# Implemented providers: mock | anthropic
#   mock      — deterministic built-in planner, no network, no key (default, used by tests)
#   anthropic — Claude via the Anthropic REST API, requires ANTHROPIC_API_KEY
# Note: if AI_PROVIDER=anthropic and ANTHROPIC_API_KEY is *unset*, the coordinator
# falls back to the mock planner; if it is set but empty/invalid, planning fails
# and the error is shown in the TUI status bar.
AI_PROVIDER=mock

# Model name for the anthropic provider (ignored by mock).
AI_MODEL=claude-3-5-sonnet-20241022

# Uncomment and set only when AI_PROVIDER=anthropic. Never stored in the database or logs.
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Logging (all binaries) ────────────────────────────────────────────────────
# tracing EnvFilter. The coordinator logs to stderr so the TUI is not corrupted:
#     cargo run --bin coordinator 2> coordinator_debug.log
RUST_LOG=agentmesh=debug,coordinator=debug,info

# ─── Mock Agent (agent-mock) ───────────────────────────────────────────────────
# Simulated work delay per progress stage, in milliseconds (default 1000).
MOCK_TASK_DELAY_MS=3000

# Human owner label shown in the fleet dashboard.
MOCK_AGENT_OWNER=Alice

# Optional fixed identity. MUST be a valid UUID, otherwise it is ignored and a
# random UUID is generated on every start (creating a new agent row each time).
# MOCK_AGENT_ID=11111111-1111-4111-8111-111111111111

# Key presented at registration (default agentmesh_mock_key). The first
# registration of an agent ID stores this key; later registrations must match.
MOCK_AGENT_API_KEY=agentmesh_mock_key

# ─── agy Agent (agent-agy) ─────────────────────────────────────────────────────
# Optional variables are commented out on purpose: an empty value is NOT the
# same as unset (e.g. AGY_BIN_PATH="" would try to execute an empty path).

# Human owner label.
AGY_AGENT_OWNER=AgyDev

# Optional fixed identity (valid UUID). Keep it stable so the agent re-registers
# as the same row after restarts.
# AGY_AGENT_ID=22222222-2222-4222-8222-222222222222

# Key presented at registration (default agentmesh_agy_key). Use the
# am_ak_<64 hex> format to have it stored as a SHA-256 hash:
#     AGY_AGENT_API_KEY="am_ak_$(openssl rand -hex 32)"
AGY_AGENT_API_KEY=agentmesh_agy_key

# Path to the agy CLI. Default: ~/.local/bin/agy if it exists, else `agy` on PATH.
# AGY_BIN_PATH=/home/you/.local/bin/agy

# Optional agy flags. Effort: low | medium | high (default medium).
# AGY_MODEL=
AGY_EFFORT=medium

# Default working directory for agy; overridden per task by TaskSpec.repo_path.
# AGY_WORKSPACE_DIR=/path/to/repo

# Kill the agy subprocess after this many seconds (default 600).
AGY_TIMEOUT_SECS=600
